<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.bareun</groupId>
        <artifactId>bareun-analysis-parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>opensearch-analysis-bareun</artifactId>
    <name>opensearch-analysis-bareun</name>
    <description>OpenSearch analysis plugin for bareun Korean NLP</description>

    <properties>
        <!--
          OpenSearch 도 플러그인 descriptor 의 opensearch.version 이 노드 버전과 정확히
          같아야 로드한다. Elasticsearch 와 같은 이유로 대상 버전마다 zip 을 따로 만든다.

          산출물 이름에 대상 버전이 들어간다:
          opensearch-analysis-bareun-1.1.0-os<OpenSearch버전>.zip

              mvn -pl bareun-analysis-opensearch -am package             # 기본 대상(2.19.7)
              mvn -pl bareun-analysis-opensearch -am -Pos3 package       # 3.9.0
              mvn ... -Dopensearch.version=2.18.0 package                # 임의 버전
        -->
        <opensearch.version>2.19.7</opensearch.version>
        <opensearch.assembly.descriptor>${basedir}/src/main/assemblies/plugin.xml</opensearch.assembly.descriptor>
    </properties>

    <profiles>
        <profile>
            <id>os3</id>
            <properties>
                <opensearch.version>3.9.0</opensearch.version>
                <!-- OpenSearch 3 은 JDK 21 이상에서 돈다. -->
                <maven.compiler.release>21</maven.compiler.release>
                <maven.compiler.target>21</maven.compiler.target>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>ai.bareun</groupId>
            <artifactId>bareun-analysis-common</artifactId>
            <exclusions>
                <!-- 아래 provided 선언만으로는 부족하다. 공통 모듈을 거쳐 compile 로 다시
                     들어오는 길을 막아야 zip 에서 빠진다. -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
          OpenSearch 는 코어의 lib/ 에 protobuf-java 를 들고 있다(2.19 는 3.25.5, 3.9 는 3.25.8).
          플러그인 zip 에 같은 jar 를 담으면 설치 단계의 jar hell 검사가
          "class: com.google.protobuf.AbstractMessage$Builder" 로 설치를 거부한다.
          Elasticsearch 는 모듈별 클래스로더라 상관없지만 OpenSearch 에서는 담지 않고
          코어 것을 쓴다. 공통 모듈이 끌어오는 compile 의존을 provided 로 눌러 둔다.
        -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.opensearch</groupId>
            <artifactId>opensearch</artifactId>
            <version>${opensearch.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <!-- 어느 OpenSearch 버전용인지 파일 이름만 보고 알 수 있어야 한다. -->
                    <finalName>${project.artifactId}-${project.version}-os${opensearch.version}</finalName>
                    <outputDirectory>${project.build.directory}/releases/</outputDirectory>
                    <descriptors>
                        <descriptor>${opensearch.assembly.descriptor}</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
