<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.bareun</groupId>
    <artifactId>bareun-analysis-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>bareun-analysis-parent</name>
    <description>Elasticsearch and OpenSearch analysis plugins for bareun Korean NLP</description>
    <url>https://github.com/bareun-nlp/bareun-es-plugin</url>

    <licenses>
        <license>
            <name>BSD 3-Clause</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!--
      Elasticsearch 와 OpenSearch 는 플러그인 API 의 패키지(org.elasticsearch / org.opensearch)가
      갈라져 있고, 둘 다 descriptor 의 버전이 노드 버전과 정확히 같아야 플러그인을 로드한다.
      그래서 제품마다 모듈을 나누고, 각 모듈은 대상 버전마다 zip 을 따로 만든다.

        bareun-analysis-common         바른 서버 호출·토크나이저·토큰 필터(제품 무관)
        bareun-analysis-elasticsearch  Elasticsearch 플러그인 (8.19.x, 9.x)
        bareun-analysis-opensearch     OpenSearch 플러그인 (2.x, 3.x)
    -->
    <modules>
        <module>bareun-analysis-common</module>
        <module>bareun-analysis-elasticsearch</module>
        <module>bareun-analysis-opensearch</module>
    </modules>

    <profiles>
        <!-- 실제 컨테이너를 띄우는 통합 시험. 도커가 필요해서 기본 빌드에서는 뺀다.
             scripts/it.sh 로 돌린다. -->
        <profile>
            <id>it</id>
            <modules>
                <module>bareun-analysis-it</module>
            </modules>
        </profile>
    </profiles>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.target>17</maven.compiler.target>
        <protobuf.version>3.25.5</protobuf.version>
        <junit.version>5.11.3</junit.version>
        <!-- 공통 모듈을 컴파일할 때 쓰는 Lucene. 쓰는 API(Tokenizer·FilteringTokenFilter·속성)가
             Lucene 9 와 10 에서 같아 이 한 벌로 ES 8·9 와 OpenSearch 2·3 에서 모두 돈다.
             실행은 각 제품이 들고 있는 Lucene 으로 한다(통합 시험으로 확인). -->
        <lucene.version>9.12.2</lucene.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.bareun</groupId>
                <artifactId>bareun-analysis-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- 없으면 surefire 가 JUnit 5 를 못 알아보고 JUnit 3 제공자를 골라
                 "junit/framework/TestCase" 로 죽는다. -->
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>1.11.3</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <dependencies>
                        <!-- 제공자를 명시하지 않으면 surefire 가 JUnit 3 제공자를 골라 죽는다. -->
                        <dependency>
                            <groupId>org.apache.maven.surefire</groupId>
                            <artifactId>surefire-junit-platform</artifactId>
                            <version>3.5.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.maven.surefire</groupId>
                            <artifactId>surefire-junit-platform</artifactId>
                            <version>3.5.2</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
